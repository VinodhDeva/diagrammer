{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity-relationship diagram",
  "description": "Tables, their columns and keys, and how they relate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "entities"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "direction": {
          "type": "string",
          "enum": [
            "LR",
            "TB"
          ],
          "description": "Main flow direction. Default LR."
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Functional domains or database schemas that contain entities.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "enum": [
              "domain",
              "schema"
            ]
          },
          "parent": {
            "type": "string",
            "description": "Id of the enclosing group."
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "description": "Table name."
          },
          "label": {
            "type": "string",
            "maxLength": 60,
            "description": "Display name; defaults to id."
          },
          "group": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "key": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "pk",
                      "fk",
                      "uk"
                    ]
                  },
                  "description": "Key roles, e.g. [\"pk\", \"fk\"]."
                },
                "references": {
                  "type": "string",
                  "description": "For fk columns: entity.column, e.g. users.id."
                },
                "nullable": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Shown as a tooltip."
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "1:1",
              "1:N",
              "N:1",
              "N:M"
            ],
            "description": "from:to. Default 1:N."
          },
          "label": {
            "type": "string",
            "maxLength": 50
          }
        }
      }
    }
  }
}
