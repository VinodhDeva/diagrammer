{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data-flow diagram",
  "description": "Where data comes from, how it is processed and stored, and who consumes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "nodes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "direction": {
          "type": "string",
          "enum": [
            "LR",
            "TB"
          ],
          "description": "Main flow direction. Default LR."
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Zones or stages that contain nodes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "enum": [
              "zone",
              "stage",
              "system",
              "team"
            ]
          },
          "parent": {
            "type": "string",
            "description": "Id of the enclosing group."
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "process",
              "store",
              "sink",
              "external"
            ],
            "description": "Default process. source has no inputs, sink has no outputs."
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Shown as a tooltip."
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 60,
            "description": "What moves, e.g. click events."
          },
          "style": {
            "type": "string",
            "enum": [
              "stream",
              "batch",
              "event"
            ],
            "description": "Default stream. batch is bold, event is dashed."
          }
        }
      }
    }
  }
}
