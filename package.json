{
  "name": "diagrammer-mcp",
  "version": "0.6.0",
  "type": "module",
  "description": "MCP server that renders validated diagrams (architecture, workflow, sequence, dataflow, lifecycle, ERD, class, tree, timeline, waterfall) and one-page explainers as standalone HTML.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diagram",
    "architecture",
    "sequence-diagram",
    "erd",
    "uml",
    "timeline",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinodhDeva/diagrammer.git"
  },
  "homepage": "https://github.com/VinodhDeva/diagrammer#readme",
  "bugs": "https://github.com/VinodhDeva/diagrammer/issues",
  "bin": {
    "diagrammer-mcp": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "lib/",
    "schemas/",
    "examples/",
    "NOTICE",
    "docs/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/schema-docs.mjs --check && node test.mjs",
    "docs": "node scripts/schema-docs.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1"
  }
}
